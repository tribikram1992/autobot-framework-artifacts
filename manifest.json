{
  "_comment": "Autobot Framework Artifact Registry — updated automatically by CI on each tagged release. Never edit manually.",
  "_naming_convention": "{Platform}_{FamilyName}_{Language}_{TestFramework}",
  "_platform_rule": "WebDriverIO = Mobile (Appium-backed). Playwright covers Web UI and API (separate repos). No BDD/C#/Python-API until those framework repos are built.",
  "schema_version": "1",
  "maven_repo_url": "https://raw.githubusercontent.com/tribikram1992/autobot-framework-artifacts/main/maven-repo",
  "frameworks": {

    "web-vibium-java-testng": {
      "description": "Vibium Web / Java / Selenium + TestNG",
      "source_repo": "tribikram1992/Web_VibiumFramework_Java_TestNG",
      "platform": "web", "language": "java", "test_framework": "testng",
      "adapter_key": ["web", "java", "testng"],
      "artifact_type": "jar", "group_id": "io.vibium",
      "latest": null, "versions": {}
    },

    "mobile-vibium-java-testng": {
      "description": "Vibium Mobile / Java / Appium + TestNG",
      "source_repo": "tribikram1992/Mobile_VibiumFramework_Java_TestNG",
      "platform": "mobile", "language": "java", "test_framework": "testng",
      "adapter_key": ["mobile", "java", "testng"],
      "artifact_type": "jar", "group_id": "io.vibium",
      "latest": null, "versions": {}
    },

    "api-vibium-java-testng": {
      "description": "Vibium API / Java / RestAssured + TestNG",
      "source_repo": "tribikram1992/API_VibiumFramework_Java_TestNG",
      "platform": "api", "language": "java", "test_framework": "testng",
      "adapter_key": ["api", "java", "testng"],
      "artifact_type": "jar", "group_id": "io.vibium",
      "latest": null, "versions": {}
    },

    "web-vibium-python-pytest": {
      "description": "Vibium Web / Python / Selenium + pytest",
      "source_repo": "tribikram1992/Web_VibiumFramework_Python_Pytest",
      "platform": "web", "language": "python", "test_framework": "pytest",
      "adapter_key": ["web", "python", "pytest"],
      "artifact_type": "wheel", "requires_python": ">=3.11,<3.13",
      "latest": null, "versions": {}
    },

    "web-vibium-javascript-playwright": {
      "description": "Vibium Web / JavaScript / Playwright (browser UI)",
      "source_repo": "tribikram1992/Web_VibiumFramework_JavaScript_Playwright",
      "platform": "web", "language": "javascript", "test_framework": "playwright",
      "adapter_key": ["web", "javascript", "playwright"],
      "artifact_type": "npm",
      "latest": null, "versions": {}
    },

    "api-vibium-javascript-playwright": {
      "description": "Vibium API / JavaScript / Playwright APIRequestContext",
      "source_repo": "tribikram1992/API_VibiumFramework_JavaScript_Playwright",
      "platform": "api", "language": "javascript", "test_framework": "playwright",
      "adapter_key": ["api", "javascript", "playwright"],
      "artifact_type": "npm",
      "latest": null, "versions": {}
    }

  }
}
